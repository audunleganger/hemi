import kotlin.Boolean;

-- In Android local mode a single implicit user row owns all data (A-5).
CREATE TABLE app_user (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    username TEXT NOT NULL UNIQUE COLLATE NOCASE,
    password_hash TEXT,
    is_admin INTEGER AS Boolean NOT NULL DEFAULT 0,
    is_disabled INTEGER AS Boolean NOT NULL DEFAULT 0,
    locale TEXT,
    created_at INTEGER NOT NULL,
    -- Settings (S-1 … S-5). Times of day are minutes since midnight.
    time_zone TEXT,
    theme TEXT NOT NULL DEFAULT 'dark',
    dim_during_attacks INTEGER AS Boolean NOT NULL DEFAULT 1,
    day_cutoff INTEGER NOT NULL DEFAULT 240,
    follow_up_minutes INTEGER NOT NULL DEFAULT 120,
    -- Null: the most used medication (S-3).
    usual_medication_id INTEGER REFERENCES medication(id) ON DELETE SET NULL,
    -- ISO days of week, comma-separated (1 = Monday).
    workdays TEXT NOT NULL DEFAULT '1,2,3,4,5',
    work_start INTEGER NOT NULL DEFAULT 480,
    work_end INTEGER NOT NULL DEFAULT 840,
    -- The calendar feed's secret (X-3); null: the feed is off. Kept as is, so the feed URL can be shown again;
    -- it only gives read access to that feed.
    ics_token TEXT UNIQUE
);

countUsers:
SELECT count(*) FROM app_user;

countActiveAdmins:
SELECT count(*) FROM app_user WHERE is_admin = 1 AND is_disabled = 0;

insertUser:
INSERT INTO app_user(username, password_hash, is_admin, is_disabled, locale, created_at)
VALUES (?, ?, ?, 0, ?, ?);

lastInsertRowId:
SELECT last_insert_rowid();

selectById:
SELECT * FROM app_user WHERE id = ?;

selectByUsername:
SELECT * FROM app_user WHERE username = ?;

selectAll:
SELECT * FROM app_user ORDER BY username;

selectFirst:
SELECT * FROM app_user ORDER BY id LIMIT 1;

updatePassword:
UPDATE app_user SET password_hash = ? WHERE id = ?;

updateLocale:
UPDATE app_user SET locale = ? WHERE id = ?;

updateAdmin:
UPDATE app_user SET is_admin = ? WHERE id = ?;

updateDisabled:
UPDATE app_user SET is_disabled = ? WHERE id = ?;

updateSettings:
UPDATE app_user SET time_zone = ?, theme = ?, dim_during_attacks = ?, day_cutoff = ?, follow_up_minutes = ?,
    usual_medication_id = ?, workdays = ?, work_start = ?, work_end = ?
WHERE id = ?;

updateIcsToken:
UPDATE app_user SET ics_token = ? WHERE id = ?;

selectByIcsToken:
SELECT * FROM app_user WHERE ics_token = ? AND is_disabled = 0;
